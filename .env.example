# ==============================================================================
# AnveshakHub Enterprise ERP — Production Environment Template
# IMPORTANT: Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER-ONLY VARIABLES (NestJS Backend API / Production Host)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
APP_URL=https://your-app-domain.vercel.app
API_URL=https://your-api-domain.onrender.com/api/v1
ALLOWED_ORIGINS=https://your-app-domain.vercel.app

# Database Connection (Supabase PostgreSQL / PgBouncer Pooler)
DATABASE_URL=postgresql://postgres.xxx:xxx@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxx:xxx@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# JWT Security Secrets
JWT_SECRET=your_production_jwt_secret_64_chars_long
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_production_refresh_secret_64_chars_long
JWT_REFRESH_EXPIRES_IN=7d

# Supabase Admin Integration (Server-side Only)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Transactional Email System (SMTP / Resend)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=noreply@yourdomain.com
RESEND_API_KEY=re_your_resend_key_here

# Storage & Logging
S3_BUCKET=anveshak-private-documents
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# PUBLIC VARIABLES (Next.js Frontend / Vercel Environment Variables)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://your-api-domain.onrender.com/api/v1
NEXT_PUBLIC_APP_URL=https://your-app-domain.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
