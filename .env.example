# Environment Configuration for AnveshakHub Enterprise Application

# Node Environment
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Application URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://anveshak_user:anveshak_pass@localhost:5432/anveshak_db?schema=public

# Redis (BullMQ / Background Jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=anveshak_super_secret_jwt_key_change_in_production_2026!
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=anveshak_refresh_secret_key_change_in_production_2026!
JWT_REFRESH_EXPIRES_IN=7d

# Private S3-Compatible Object Storage (Document Storage)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=anveshak-private-documents
S3_REGION=us-east-1
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_password
S3_FORCE_PATH_STYLE=true

# Email System (SES / Resend placeholder)
EMAIL_FROM=noreply@anveshakhub.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Monitoring & Logging
SENTRY_DSN=
LOG_LEVEL=debug
